  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "resolveJsonModule": true
  },
